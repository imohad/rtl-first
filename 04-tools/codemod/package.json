{
  "name": "@rtl-first/codemod",
  "version": "0.2.0",
  "description": "Convert CSS physical properties to logical for RTL. Multi-engine: PostCSS AST for CSS, jscodeshift for CSS-in-JS, Tailwind class mapper, regex fallback.",
  "main": "src/index.js",
  "bin": {
    "rtl-codemod": "src/cli.js"
  },
  "type": "module",
  "scripts": {
    "test": "node --test test/**/*.test.js"
  },
  "peerDependencies": {
    "jscodeshift": "^17.3.0",
    "postcss": "^8.5.8"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    },
    "jscodeshift": {
      "optional": true
    }
  },
  "keywords": [
    "rtl",
    "css",
    "logical-properties",
    "codemod",
    "postcss",
    "jscodeshift",
    "tailwind",
    "ast",
    "right-to-left",
    "i18n",
    "arabic",
    "hebrew"
  ],
  "author": "Mohammad AlShammari <imohad>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/imohad/rtl-first",
    "directory": "04-tools/codemod"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "src/"
  ]
}
